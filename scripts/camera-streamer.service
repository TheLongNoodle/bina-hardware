[Unit]
Description=Bina Camera MJPEG Streamer
After=WiFiDirectAutorun.service
Wants=WiFiDirectAutorun.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/vitrobiani/Downloads/bina-hardware-main/scripts/libcamera-streamer.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
